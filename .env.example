# ── Agency Gateway ──────────────────────────────────────────────────
# Unified OpenAI-compatible endpoint: chat (LiteLLM) + images (CF Workers AI)
# + audio TTS/STT (CF Workers AI), behind one authenticated front door.
# Live: https://gateway.jami.studio  (DO droplet via Cloudflare Tunnel)
#
# Chat models:    agency/config/litellm/config.yaml (191+ aliases)
# Image models:   cf-img-flux-1-schnell, cf-img-flux-2-dev, cf-img-flux-2-klein-4b
# TTS models:     cf-tts-aura-2-en, cf-tts-aura-2-es, cf-tts-aura-1, cf-tts-melotts
# STT models:     cf-stt-whisper-large-v3-turbo, cf-stt-whisper, cf-stt-whisper-tiny-en
AGENCY_GATEWAY_BASE_URL=https://gateway.jami.studio/v1
AGENCY_GATEWAY_API_KEY=

# The context-pool indexer (scripts/context-index.ts, run via `pnpm index`)
# also authenticates against the gateway with these two vars — it calls the
# gateway's `/v1/embeddings` (`agency-embed-code`, Voyage via MongoDB Atlas
# credits). No client-side Atlas credentials are needed; the gateway funds
# the route. See docs/research/context-pools-2026-08-16.md.

# ── Route auth ──────────────────────────────────────────────────────
# Local dev is always accepted. Vercel OIDC handles internal runtime calls;
# HTTP Basic provides direct owner/operator access in production.
LUNA_HTTP_USERNAME=luna
LUNA_HTTP_PASSWORD=

# ── Observability (PostHog AI) ───────────────────────────────────────
# PostHog project token for OTel trace ingestion. This is the project token
# (ingestion), not the API key. Find it under Project Settings → API Key.
POSTHOG_PROJECT_TOKEN=
# PostHog host (https://us.i.posthog.com for US, https://eu.i.posthog.com for EU)
POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry ──────────────────────────────────────────────────────────
# Error tracking + performance tracing. Same Sentry project as agency.
SENTRY_DSN=
SENTRY_ENVIRONMENT=luna-local

# ── Web search providers ────────────────────────────────────────────
# Free tiers are available at the respective sites. Eve ships with one tool
# per provider so subagents can pick the right search backend for the job.
#   - Tavily:   https://tavily.com   (agent/tools/web_search.ts)
#   - Exa:      https://exa.ai      (agent/tools/exa_search.ts)
#   - Brave:    https://brave.com/search/api (agent/tools/brave_search.ts)
#   - Firecrawl: https://firecrawl.dev (agent/tools/firecrawl_search.ts)
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=

# ── Outbound messaging ────────────────────────────────────────────────
# Eve sends only to these fixed owner destinations. Verizon documents
# @vtext.com for text and @vzwpix.com for image attachments. Text email must
# total no more than 160 characters including recipient, subject, and message.
VERIZON_TEXT_USER_EMAIL=
VERIZON_MMS_USER_EMAIL=

# Select exactly one transport: smtp, resend, or agentmail.
OUTBOUND_EMAIL_PROVIDER=agentmail

# SMTP transport. SMTP_FROM_EMAIL must be a valid sender address; SMTP_USER
# may be a provider username rather than an email address.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Resend powers Luna's bidirectional email channel and the legacy outbound
# transport during cutover. The webhook secret is created per Resend webhook.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=luna@mail.navinhill.com
LUNA_OWNER_EMAIL=
LUNA_OWNER_EMAILS=

# Vercel Marketplace Neon. Chat SDK accepts DATABASE_URL or POSTGRES_URL.
DATABASE_URL=

# AgentMail transport. The address identifies the sending inbox.
AGENTMAIL_API_KEY=
AGENTMAIL_EMAIL_ADDRESS=

# ── Optional: connection / tool secrets ──────────────────────────────
# Add secrets for MCP connections, tools, etc. here as you add them.
